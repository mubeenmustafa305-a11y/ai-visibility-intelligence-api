# Flask
FLASK_APP=wsgi:app
FLASK_ENV=development
SECRET_KEY=change-me

# Database — SQLite for local/dev (default). For PostgreSQL:
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ai_visibility
# and install: pip install psycopg2-binary
DATABASE_URL=sqlite:///dev.db

# LLM provider — set ONE key matching LLM_PROVIDER
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# DataForSEO (required for real search volume / competition / visibility)
DATAFORSEO_LOGIN=your-dataforseo-login
DATAFORSEO_PASSWORD=your-dataforseo-password
DATAFORSEO_BASE_URL=https://api.dataforseo.com
DATAFORSEO_LOCATION_CODE=2840
DATAFORSEO_LANGUAGE_CODE=en
DATAFORSEO_TIMEOUT_SECONDS=60
